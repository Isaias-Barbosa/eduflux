# Segredo usado pelo Better Auth para assinar tokens e sessões.
# Gere um novo valor com: npx auth secret
BETTER_AUTH_SECRET=

# URL pública da aplicação (sem barra no final).
BETTER_AUTH_URL=http://localhost:3000

# Banco de dados. Por padrão o projeto usa um arquivo SQLite local em ./data.
# Para usar o Turso no futuro: libsql://seu-banco.turso.io (com AUTH_TOKEN extra).
DATABASE_URL=file:./data/eduflux.db
