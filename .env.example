# Banco fixo do Turso (recomendado em produção): persiste entre deploys.
EDUFLUX_DATABASE_URL=
EDUFLUX_DATABASE_TOKEN=

# Integração Turso no Vercel: criadas automaticamente, mas apontam para um
# branch por deployment. São usadas apenas se EDUFLUX_* não estiver definido.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# alternativa para desenvolvimento local (arquivo SQLite)
DATABASE_URL=file:./data/eduflux.db

# Segredo usado pelo Better Auth para assinar sessões.
# Gere um novo valor com: npx auth secret
BETTER_AUTH_SECRET=

# URL pública da aplicação (sem barra no final).
BETTER_AUTH_URL=http://localhost:3000
